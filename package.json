{
  "name": "nuxt4-firebase",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --dotenv .env.local",
    "generate": "nuxt generate",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "deploy": "pnpm generate && firebase deploy --only hosting",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "emulators:start": "firebase emulators:start --only=auth,functions,firestore,storage --import=./.firebase",
    "emulators:import": "rm -rf .firebase && cp -r ./firebase_export .firebase",
    "emulators:export": "firebase_export && firebase emulators:export --force ./firebase_export",
    "emulators:stop": "lsof -t -i:4000 -i:5001 -i:8080 -i:8085 -i:9099 -i:9199 | xargs -r kill -9",
    "cache:clear": "rm -r .nuxt node_modules/.cache",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "nuxt prepare",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix"
  },
  "engines": {
    "node": "22"
  },
  "packageManager": "pnpm@10.15.1",
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxt/eslint": "1.9.0",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/image": "1.11.0",
    "@pinia/nuxt": "^0.11.2",
    "@vueuse/nuxt": "^13.9.0",
    "dayjs": "^1.11.18",
    "dayjs-nuxt": "^2.1.11",
    "firebase": "^12.3.0",
    "nuxt": "^4.1.2",
    "nuxt-vuefire": "1.1.0",
    "pinia-plugin-persistedstate": "^4.5.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vuefire": "^3.2.2",
    "vuetify": "^3.10.3",
    "vuetify-nuxt-module": "0.18.7"
  },
  "devDependencies": {
    "eslint": "^9.36.0",
    "firebase-tools": "^14.17.0"
  }
}